{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "revision",
        "model",
        "environment",
        "budget",
        "rubric_version"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "string",
          "minLength": 1
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "repeat",
          "status",
          "severe_error",
          "elapsed_seconds",
          "context_tokens",
          "human_interventions",
          "checks"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "unknown"
            ]
          },
          "severe_error": {
            "type": "boolean"
          },
          "checks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "skipped",
                    "unknown"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "passed"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "evidence"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "unknown",
                          "skipped"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "reason"
                    ]
                  }
                }
              ]
            }
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "context_tokens": {
            "type": "number",
            "minimum": 0
          },
          "human_interventions": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "description": "Interchange schema; run_evals.py additionally enforces exact task checks, evidence containment/hashes, visual reviewer and consistent pass/fail status."
}
